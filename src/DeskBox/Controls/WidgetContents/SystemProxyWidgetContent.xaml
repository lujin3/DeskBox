<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.WidgetContents.SystemProxyWidgetContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Padding="10,8" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: icon + card title -->
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="6"
            VerticalAlignment="Center">
            <FontIcon
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE774;" />
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding HeaderTitle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </StackPanel>

        <!-- The switch: user intent flows through Toggled; the view model's
             IsProxyEnabled mirror drives it back on external (tray) changes. -->
        <ToggleSwitch
            Grid.Row="1"
            HorizontalAlignment="Left"
            IsOn="{Binding IsProxyEnabled, Mode=OneWay}"
            Toggled="ProxyToggle_Toggled" />

        <!-- Server line when a proxy address is configured -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="6"
            VerticalAlignment="Center"
            Visibility="{Binding ServerRowVisibility}">
            <TextBlock
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding ServerLabel}" />
            <TextBlock
                FontSize="11"
                FontWeight="SemiBold"
                Text="{Binding ServerText}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </StackPanel>

        <!-- Guidance when Windows has no proxy server configured -->
        <TextBlock
            Grid.Row="2"
            FontSize="11"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{Binding NotConfiguredText}"
            TextWrapping="Wrap"
            Visibility="{Binding NotConfiguredVisibility}" />
    </Grid>
</UserControl>
